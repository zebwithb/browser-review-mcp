{
  "name": "browser-review-mcp",
  "version": "1.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "pnpm --dir extension build && pnpm --dir extension build:firefox && pnpm --dir server build",
    "build:extension": "pnpm --dir extension build",
    "build:firefox": "pnpm --dir extension build:firefox",
    "build:mcp": "pnpm --dir server build",
    "dev": "pnpm --dir extension dev",
    "dev:firefox": "pnpm --dir extension dev:firefox",
    "demo": "pnpm --dir demo dev",
    "package": "pnpm --dir extension package",
    "publish:mcp": "pnpm --dir server publish",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test \"scripts/**/*.test.ts\" && pnpm -r test",
    "version:bump": "node scripts/version.ts bump",
    "version:sync": "node scripts/version.ts sync",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
